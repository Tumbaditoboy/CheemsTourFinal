<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_root_detail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@android:color/transparent"
    tools:context=".TripDetailActivity">

    <!-- TITULO -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/trip_details"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:shadowColor="#66000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:layout_marginBottom="20dp" />

    <!-- INFORMACION DEL LUGAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F2FFFFFF"
        android:padding="18dp"
        android:elevation="5dp">

        <TextView
            android:id="@+id/tv_detail_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/place_name"
            android:textSize="24sp"
            android:textColor="#1E1E1E"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_detail_city"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/city_state"
            android:textSize="16sp"
            android:layout_marginTop="5dp"
            android:textColor="#666666" />

    </LinearLayout>

    <!-- CLIMA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="18dp"
        android:background="#EAF4FF"
        android:padding="18dp"
        android:elevation="4dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_weather_icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@android:drawable/ic_menu_report_image" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/tv_weather_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-- °C"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#1E1E1E" />

            <TextView
                android:id="@+id/tv_weather_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/loading_weather"
                android:textSize="16sp"
                android:textColor="#5F5F5F"
                android:layout_marginTop="3dp" />

        </LinearLayout>
    </LinearLayout>

    <!-- DETALLES -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="4"
        android:layout_marginTop="14dp"
        android:padding="10dp"
        android:background="#F2FFFFFF"
        android:elevation="4dp">

        <TextView
            android:id="@+id/tv_detail_temp_max"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:padding="10dp"
            android:text="Máx: --°"
            android:textSize="15sp"
            android:textColor="#333333" />

        <TextView
            android:id="@+id/tv_detail_temp_min"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:padding="10dp"
            android:text="Mín: --°"
            android:textSize="15sp"
            android:textColor="#333333" />

        <TextView
            android:id="@+id/tv_detail_humidity"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:padding="10dp"
            android:text="@string/humidity_txt"
            android:textSize="15sp"
            android:textColor="#333333" />

        <TextView
            android:id="@+id/tv_detail_wind"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:padding="10dp"
            android:text="@string/wind_txt"
            android:textSize="15sp"
            android:textColor="#333333" />

        <TextView
            android:id="@+id/tv_detail_sunrise"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:padding="10dp"
            android:text="@string/sunrise_txt"
            android:textSize="15sp"
            android:textColor="#333333" />

        <TextView
            android:id="@+id/tv_detail_sunset"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:padding="10dp"
            android:text="@string/sunset_txt"
            android:textSize="15sp"
            android:textColor="#333333" />

        <TextView
            android:id="@+id/tv_detail_local_time"
            android:layout_width="wrap_content"
            android:layout_columnSpan="2"
            android:layout_gravity="center_horizontal"
            android:padding="10dp"
            android:textStyle="bold"
            android:textSize="17sp"
            android:textColor="#295C73"
            android:text="@string/local_time" />

    </GridLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- BOTON EDITAR -->
    <Button
        android:id="@+id/btn_edit_trip"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/edit_btn"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="#295C73"
        android:textColor="@android:color/white"
        android:elevation="3dp"
        android:layout_marginBottom="10dp" />

    <!-- BOTON ELIMINAR -->
    <Button
        android:id="@+id/btn_delete_trip"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/delete_btn"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="#1C4052"
        android:textColor="@android:color/white"
        android:elevation="3dp" />

</LinearLayout>